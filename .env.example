# ============================================================
#  KOKORO SHOP LITE — Configuracion
#  Copia este archivo como  .env  y llena los valores de arriba.
#  NO cambies la seccion de EMOJIS (ya viene lista).
# ============================================================

# ---------- 1) BOT DE TELEGRAM ----------
BOT_TOKEN=                      # Token de tu bot (lo da @BotFather)
ADMIN_LOG_GROUP=                # ID del grupo donde llegan los logs (ej: -1001234567890)
ADMIN_ID=                       # Tu Telegram ID (admin del bot)
SHOP_NAME=KOKORO SHOP           # Nombre de tu tienda (se muestra en el bot)
CHANNEL_URL=                    # (opcional) Link de tu canal de Telegram
SUPPORT_URL=                    # (opcional) Link/usuario de soporte (ej: https://t.me/TuSoporte)

# ---------- 2) API KOKORO (proveedor mayorista) ----------
KOKORO_API_URL=https://api.shopdigital.app
KOKORO_API_KEY=                 # Tu API Key. Generala en el bot de KOKORO -> API LINK.
                                # Debes tener SALDO recargado para poder vender.

# ---------- 3) SUPABASE (tu base de datos) ----------
SUPABASE_URL=                   # Project URL de tu Supabase
SUPABASE_KEY=                   # service_role key de tu Supabase

# ---------- 4) PAGOS: BINANCE PAY ----------
BINANCE_API_KEY=                # API Key de tu cuenta Binance
BINANCE_SECRET_KEY=             # Secret Key de tu cuenta Binance
BINANCE_PAY_ID=                 # Tu Binance Pay ID (para recibir pagos)
BINANCE_PAY_NAME=               # Nombre que se muestra al cliente

# ---------- 5) PAGOS: BEP20 (BSC) ----------
BEP20_WALLET=                   # Tu direccion de wallet BEP20 (0x...)

# ---------- 6) OPCIONES ----------
SYNC_INTERVAL_MINUTES=5         # Cada cuantos minutos sincroniza productos con KOKORO

# ---------- 7) PANEL ADMIN WEB (deploy aparte en Vercel) ----------
ADMIN_PANEL_USER=               # Usuario para entrar al panel web
ADMIN_PANEL_PASSWORD=           # Contraseña para entrar al panel web
ADMIN_PANEL_SECRET=             # Clave secreta para firmar la sesion (genera una aleatoria y no la compartas)

